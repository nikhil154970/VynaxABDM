# Mytho_AI Server Configuration
# ============================

# Server Configuration
PORT=5001
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration (inherit from backend .env if available)
# If not set, uses MQE_SQLITE_DB for fallback SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/pharmacy_ai
MQE_SQLITE_DB=

# LLM Configuration (optional, for enhanced query routing)
# Uncomment to enable LLM-powered query enhancement
# LLM_API_KEY=your-api-key
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Timeout for database queries (milliseconds)
QUERY_TIMEOUT=10000

# Logging
LOG_FORMAT=json  # or "text" for plain text logging
