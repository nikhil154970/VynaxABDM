  subTotal     Decimal  @db.Decimal(14, 2)
  gstAmount    Decimal  @db.Decimal(14, 2)
  grandTotal   Decimal  @db.Decimal(14, 2)
  remarks      String?
  status       String   @default("Draft")
  createdBy    String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier PharmacySupplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PharmacyPurchaseOrderItem[]
  grns     PharmacyGrn[]

  @@index([status])
  @@index([supplierName])
  @@index([createdAt])
}

model PharmacyPurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  medicineId      String  @db.Uuid
  medicineName    String
  quantity        Int
  purchasePrice   Decimal @db.Decimal(14, 2)
  gstPercentage   Int
  amount          Decimal @db.Decimal(14, 2)

  purchaseOrder PharmacyPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine      PharmacyMedicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([medicineId])
}

model PharmacyGrn {
  id              String                   @id @default(uuid()) @db.Uuid
  grnNumber       String                   @unique
  purchaseOrderId String                   @db.Uuid
  poNumber        String
  supplierId      String                   @db.Uuid
  supplierName    String
  invoiceNumber   String?
  invoiceDate     DateTime?
  receivedDate    DateTime
  subTotal        Decimal                  @db.Decimal(14, 2)
  gstAmount       Decimal                  @db.Decimal(14, 2)
  grandTotal      Decimal                  @db.Decimal(14, 2)
  remarks         String?
  receiptStatus   PharmacyGrnReceiptStatus @default(Partial)
  status          String                   @default("Draft")
  createdBy       String?                  @db.Uuid
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  purchaseOrder    PharmacyPurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier         PharmacySupplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items            PharmacyGrnItem[]
  inventoryBatches PharmacyInventoryBatch[]

  @@index([status])
  @@index([poNumber])
  @@index([receivedDate])
  @@index([createdAt])
}

model PharmacyGrnItem {
  id            String   @id @default(uuid()) @db.Uuid
  grnId         String   @db.Uuid
  medicineId    String   @db.Uuid
  medicineName  String
  orderedQty    Int
  receivedQty   Int
  freeQty       Int      @default(0)
  batchNumber   String
  expiryDate    DateTime
  purchasePrice Decimal  @db.Decimal(14, 2)
  sellingPrice  Decimal  @db.Decimal(14, 2)
  mrp           Decimal  @db.Decimal(14, 2)
  gstPercentage Int
  amount        Decimal  @db.Decimal(14, 2)

  grn      PharmacyGrn      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  medicine PharmacyMedicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([grnId])
  @@index([medicineId])
}

model PharmacyInventoryBatch {
  id            String                       @id @default(uuid()) @db.Uuid
  medicineId    String                       @db.Uuid
  medicineName  String
  batchNumber   String
  expiryDate    DateTime
  purchasePrice Decimal                      @db.Decimal(14, 2)
  sellingPrice  Decimal                      @db.Decimal(14, 2)
  mrp           Decimal                      @db.Decimal(14, 2)
  qty           Int
  availableQty  Int
  gstPercentage Int
  supplierId    String                       @db.Uuid
  grnId         String                       @db.Uuid
  status        PharmacyInventoryBatchStatus @default(ACTIVE)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  medicine          PharmacyMedicine           @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  supplier          PharmacySupplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  grn               PharmacyGrn                @relation(fields: [grnId], references: [id], onDelete: Restrict)
  stockTransactions PharmacyStockTransaction[]
  billItems         PharmacyBillItem[]
  returnItems       PharmacyReturnItem[]

  @@index([medicineId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([status])
  @@index([medicineId, batchNumber])
}

model PharmacyBill {
  id               String                 @id @default(uuid()) @db.Uuid
  billNumber       String                 @unique
  billingType      PharmacyBillingType
  patientId        String?                @db.Uuid
  receptionVisitId String?                @db.Uuid
  /**
   * IPD admission this pharmacy bill belongs to (set when patient is admitted).
   * Lets reception fetch all pharmacy charges for an admission directly.
   */
  admissionId      String?                @db.Uuid
  customerName     String?
  customerMobile   String?
  patientName      String?
  patientUhid      String?
  tokenNumber      String?
  doctorName       String?
  department       String?
  visitDate        DateTime?
  subTotal         Decimal                @db.Decimal(14, 2)
  discount         Decimal                @default(0) @db.Decimal(14, 2)
  gstAmount        Decimal                @default(0) @db.Decimal(14, 2)
  grandTotal       Decimal                @db.Decimal(14, 2)
  paidAmount       Decimal                @default(0) @db.Decimal(14, 2)
  pendingAmount    Decimal                @default(0) @db.Decimal(14, 2)
  paymentMode      PharmacyPaymentMode?
  status           PharmacyBillStatus     @default(DRAFT)
  dispenseStatus   PharmacyDispenseStatus @default(PENDING)
  remarks          String?
  dueDate          DateTime?
  createdBy        String?                @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  patient   Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  admission Admission?         @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  items    PharmacyBillItem[]
  payments PharmacyPayment[]
  returns  PharmacyReturn[]

  @@index([billNumber])
  @@index([patientId])
  @@index([status])
  @@index([billingType])
  @@index([createdAt])
  @@index([dispenseStatus])
  @@index([admissionId])
}

model PharmacyPayment {
  id          String              @id @default(uuid()) @db.Uuid
  billId      String              @db.Uuid
  patientId   String?             @db.Uuid
  amount      Decimal             @db.Decimal(14, 2)
  paymentMode PharmacyPaymentMode
  notes       String?
  createdBy   String?             @db.Uuid
  createdAt   DateTime            @default(now())

  bill    PharmacyBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  patient Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([patientId])
  @@index([createdAt])
}

model PharmacyBillItem {
  id               String    @id @default(uuid()) @db.Uuid
  billId           String    @db.Uuid
  medicineId       String    @db.Uuid
  inventoryBatchId String    @db.Uuid
  medicineName     String
  batchNumber      String
  expiryDate       DateTime?
  quantity         Int
  mrp              Decimal   @db.Decimal(14, 2)
  sellingPrice     Decimal   @db.Decimal(14, 2)
  discountPercent  Decimal   @default(0) @db.Decimal(5, 2)
  gstPercentage    Int
  amount           Decimal   @db.Decimal(14, 2)

  bill     PharmacyBill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  medicine PharmacyMedicine       @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch    PharmacyInventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([medicineId])
  @@index([inventoryBatchId])
}

model PharmacyReturn {
  id              String               @id @default(uuid()) @db.Uuid
  returnNumber    String               @unique
  returnType      PharmacyReturnType
  status          PharmacyReturnStatus @default(PENDING)
  billId          String?              @db.Uuid
  supplierId      String?              @db.Uuid
  patientId       String?              @db.Uuid
  referenceNumber String?
  patientName     String?
  supplierName    String?
  refundType      PharmacyRefundType?
  totalAmount     Decimal              @default(0) @db.Decimal(14, 2)
  remarks         String?
  createdBy       String?              @db.Uuid
  approvedBy      String?              @db.Uuid
  approvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  bill     PharmacyBill?        @relation(fields: [billId], references: [id], onDelete: SetNull)
  supplier PharmacySupplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  patient  Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
  items    PharmacyReturnItem[]

  @@index([returnNumber])
  @@index([returnType])
  @@index([status])
  @@index([billId])
  @@index([supplierId])
  @@index([patientId])
  @@index([createdAt])
}

model PharmacyReturnItem {
  id               String  @id @default(uuid()) @db.Uuid
  returnId         String  @db.Uuid
  medicineId       String  @db.Uuid
  inventoryBatchId String  @db.Uuid
  billItemId       String? @db.Uuid
  medicineName     String
  batchNumber      String
  quantity         Int
  purchasePrice    Decimal @db.Decimal(14, 2)
  sellingPrice     Decimal @db.Decimal(14, 2)
  amount           Decimal @db.Decimal(14, 2)
  reason           String?

  pharmacyReturn PharmacyReturn         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  medicine       PharmacyMedicine       @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch          PharmacyInventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([medicineId])
  @@index([inventoryBatchId])
  @@index([billItemId])
}

model PharmacyStockTransaction {
  id            String                       @id @default(uuid()) @db.Uuid
  medicineId    String                       @db.Uuid
  batchId       String                       @db.Uuid
  type          PharmacyStockTransactionType
  qtyIn         Int                          @default(0)
  qtyOut        Int                          @default(0)
  balance       Int
  referenceType String?
  referenceId   String?                      @db.Uuid
  notes         String?
  createdAt     DateTime                     @default(now())

  medicine PharmacyMedicine       @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch    PharmacyInventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([medicineId])
  @@index([batchId])
  @@index([type])
  @@index([createdAt])
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  BILLED
  CANCELLED
}

model PharmacyQueue {
  id String @id @default(cuid())

  patientId      String  @db.Uuid
  appointmentId  String? @db.Uuid
  /**
   * Consultation id (doctor prescription JSON lives inside Consultation)
   */
  prescriptionId String? @db.Uuid

  doctorId             String? @db.Uuid
  sentByReceptionistId String  @db.Uuid
  /**
   * IPD admission this medicine request belongs to (nurse-created IPD requests).
   * Null for OPD / walk-in prescriptions sent from reception.
   */
  admissionId          String? @db.Uuid

  tokenNumber String @unique

  status QueueStatus @default(WAITING)

  sentAt DateTime

  billedBillId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor             Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  sentByReceptionist User         @relation("PharmacyQueueSentBy", fields: [sentByReceptionistId], references: [id], onDelete: Restrict)
  admission          Admission?   @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  items PharmacyQueueItem[]

  @@index([status, sentAt])
  @@index([patientId, sentAt])
  @@index([doctorId, sentAt])
  @@index([sentByReceptionistId, sentAt])
  @@index([admissionId, sentAt])
}

model PharmacyQueueItem {
  id String @id @default(uuid()) @db.Uuid

  queueId      String
  medicineId   String? @db.Uuid
  medicineName String

  dosage    String?
  frequency String?
  duration  String?
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  queue    PharmacyQueue     @relation(fields: [queueId], references: [id], onDelete: Cascade)
  medicine PharmacyMedicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([queueId])
  @@index([medicineId])
  @@index([medicineName])
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  headId      String?  @unique @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  head User? @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

// ──────── Shift Management ────────

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments      ShiftAssignment[]
  shiftHistoryPrev ShiftHistory[]    @relation("PreviousShift")
  shiftHistoryNew  ShiftHistory[]    @relation("NewShift")

  @@index([isActive])
}

model ShiftAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  shiftId      String   @db.Uuid
  employeeId   String   @db.Uuid
  assignedDate DateTime @default(now())
  assignedById String   @db.Uuid
  createdAt    DateTime @default(now())

  shift      Shift @relation(fields: [shiftId], references: [id])
  employee   User  @relation("ShiftAssignmentEmployee", fields: [employeeId], references: [id])
  assignedBy User  @relation("ShiftAssignmentAssigner", fields: [assignedById], references: [id])

  history ShiftHistory[]

  @@index([shiftId])
  @@index([employeeId])
  @@index([assignedDate])
}

model ShiftHistory {
  id              String   @id @default(uuid()) @db.Uuid
  assignmentId    String   @db.Uuid
  action          String
  previousShiftId String?  @db.Uuid
  newShiftId      String?  @db.Uuid
  changedById     String   @db.Uuid
  reason          String?
  createdAt       DateTime @default(now())

  assignment    ShiftAssignment @relation(fields: [assignmentId], references: [id])
  previousShift Shift?          @relation("PreviousShift", fields: [previousShiftId], references: [id])
  newShift      Shift?          @relation("NewShift", fields: [newShiftId], references: [id])
  changedBy     User            @relation("ShiftHistoryChangedBy", fields: [changedById], references: [id])

  @@index([assignmentId])
  @@index([createdAt])
}

model AllocationRequest {
  id                 String    @id @default(uuid()) @db.Uuid
  requestNumber      String    @unique
  patientId          String    @db.Uuid
  uhid               String
  patientName        String
  admissionId        String?   @db.Uuid
  otRequestId        String?   @db.Uuid
  sourceModule       String // IPD, OT, RECOVERY
  department         String?
  requestedStaffType String // NURSE, OT_NURSE, OT_TECHNICIAN
  reason             String?
  requiredShift      String? // MORNING, EVENING, NIGHT (original request)
  assignedShift      String? // MORNING, EVENING, NIGHT (actual assignment)
  priority           String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED, TRANSFERRED
  requestedById      String    @db.Uuid
  requestedByName    String
  assignedToId       String?   @db.Uuid
  assignedToName     String?
  assignedById       String?   @db.Uuid
  assignedByName     String?
  assignedAt         DateTime?
  approvedById       String?   @db.Uuid
  approvedByName     String?
  approvedAt         DateTime?
  rejectedById       String?   @db.Uuid
  rejectedByName     String?
  rejectedAt         DateTime?
  rejectionReason    String?
  remarks            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  history AllocationRequestHistory[]

  @@index([status])
  @@index([priority])
  @@index([sourceModule])
  @@index([uhid])
  @@index([createdAt])
}

model AllocationRequestHistory {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @db.Uuid
  action    String // REQUEST_CREATED, REQUEST_APPROVED, REQUEST_REJECTED, STAFF_ASSIGNED, STAFF_REASSIGNED
  userId    String   @db.Uuid
  userName  String
  details   String? // JSON with extra info
  createdAt DateTime @default(now())

  request AllocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
}

model NurseDuty {
  id        String   @id @default(uuid()) @db.Uuid
  nurseId   String   @db.Uuid
  nurseName String
  wardId    String
  wardName  String
  shift     String // MORNING, EVENING, NIGHT
  dutyDate  DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nurseId, dutyDate, shift])
  @@index([nurseId])
  @@index([wardId])
  @@index([dutyDate])
}

// ──────── Duty Roster (Nurse & Staff Daily Duty Management) ────────

enum DutyType {
  WARD
  RECOVERY
  OT
  EMERGENCY
}

enum DutyStatus {
  UPCOMING
  ON_DUTY
  COMPLETED
  OFF_DUTY
}

model DutyRoster {
  id           String     @id @default(uuid()) @db.Uuid
  date         DateTime   @db.Date
  shift        String // MORNING, EVENING, NIGHT
  employeeId   String // UUID of the assigned employee
  employeeName String
  department   String?
  dutyType     DutyType
  dutyLocation String?
  startTime    String?
  endTime      String?
  status       DutyStatus @default(UPCOMING)
  remarks      String?

  // Ward-specific
  wardType WardType?

  // Patient assignments (stored as JSON string arrays)
  assignedPatientIds String?
  bedIds             String?

  // OT-specific
  otRoomName  String?
  surgeryId   String?
  surgeonName String?
  timeSlot    String?

  // Recovery-specific
  recoveryRoomName String?

  // Computed workload
  patientCount Int @default(0)

  // Metadata
  createdById   String // UUID of creator
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@index([shift])
  @@index([dutyType])
  @@index([status])
  @@index([employeeId, date, shift])
}

// ──────── Nurse Tasks (manual tasks added by nurse for a patient) ────────

model NurseTask {
  id          String    @id @default(uuid()) @db.Uuid
  admissionId String    @db.Uuid
  patientId   String    @db.Uuid
  patientName String?
  nurseId     String    @db.Uuid
  task        String
  status      String    @default("PENDING") // PENDING / COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  nurse User @relation(fields: [nurseId], references: [id])

  @@index([nurseId])
  @@index([admissionId])
  @@index([status])
}

// ──────── Doctor Orders (manually managed by nurse for tracking) ────────

model DoctorOrder {
  id          String    @id @default(uuid()) @db.Uuid
  admissionId String    @db.Uuid
  patientId   String    @db.Uuid
  patientName String?
  nurseId     String    @db.Uuid
  orderText   String
  status      String    @default("PENDING") // PENDING / COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  nurse User @relation(fields: [nurseId], references: [id])

  @@index([nurseId])
  @@index([admissionId])
  @@index([status])
}

// ─── OT↔Pharmacy Medicine Issue/Return ───

model OtMedicineIssue {
  id               String @id @default(uuid()) @db.Uuid
  issueNumber      String @unique
  surgerySessionId String @db.Uuid
  otRequestId      String @db.Uuid
  patientId        String @db.Uuid

  status OtMedicineIssueStatus @default(REQUESTED)

  requestedById   String?   @db.Uuid
  requestedByName String?
  requestedAt     DateTime?

  issuedById   String?   @db.Uuid
  issuedByName String?
  issuedAt     DateTime?

  receivedByOtId   String? @db.Uuid
  receivedByOtName String?

  returnSubmittedAt   DateTime?
  returnConfirmedAt   DateTime?
  returnConfirmedById String?   @db.Uuid

  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surgerySession SurgerySession        @relation(fields: [surgerySessionId], references: [id], onDelete: Cascade)
  patient        Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items          OtMedicineIssueItem[]
  movements      OtMedicineMovement[]

  @@index([surgerySessionId])
  @@index([otRequestId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model OtMedicineIssueItem {
  id               String @id @default(uuid()) @db.Uuid
  issueId          String @db.Uuid
  medicineId       String @db.Uuid
  inventoryBatchId String @db.Uuid

  medicineName String
  genericName  String?
  batchNumber  String
  expiryDate   DateTime?

  quantityRequested     Int @default(0)
  quantityIssued        Int @default(0)
  quantityUsed          Int @default(0)
  quantityReturned      Int @default(0)
  quantityReturnPending Int @default(0)

  unitPrice         Int @default(0)
  lineIssuedTotal   Int @default(0)
  lineUsedTotal     Int @default(0)
  lineReturnedTotal Int @default(0)
  lineNetTotal      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue OtMedicineIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([medicineId])
  @@index([inventoryBatchId])
}

model OtMedicineMovement {
  id              String                 @id @default(uuid()) @db.Uuid
  issueId         String                 @db.Uuid
  issueItemId     String?                @db.Uuid
  movementType    OtMedicineMovementType
  quantity        Int
  movementAt      DateTime               @default(now())
  performedById   String                 @db.Uuid
  performedByName String?
  notes           String?

  issue OtMedicineIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, movementAt])
  @@index([movementType])
}
