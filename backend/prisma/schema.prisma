generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  LAB_TECHNICIAN
  HR_MANAGER
  OT_TECHNICIAN
}

enum ActivityAction {
  LOGIN
  CREATE_USER
  UPDATE_STATUS
  CREATE_OT_REQUEST
  UPDATE_OT_REQUEST_STATUS
  SUBMIT_PRE_OP_ASSESSMENT
}

enum ActivityModule {
  AUTH
  USER
  OT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RegistrationSource {
  RECEPTION
  SELF
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum ConsultationDisposition {
  NORMAL
  REFER_ADMIT
  REFER_DEPT
}

enum AdmissionStatus {
  ADMITTED
  UNDER_TREATMENT
  READY_FOR_DISCHARGE
  /**
   * Nurse requested discharge; awaiting receptionist/doctor final processing
   */
  DISCHARGE_REQUESTED
}

enum PatientClinicalCondition {
  CRITICAL
  STABLE
}

enum WardType {
  GENERAL
  ICU
  PRIVATE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum OtRoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  INACTIVE
}

enum NotificationType {
  ALERT
  UPDATE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum VisitType {
  OPD
  IPD
}

enum ReceptionVisitStatus {
  WAITING
  IN_CONSULTATION
  COMPLETED
  ADMITTED
  ACTIVE
  DISCHARGED
}

enum BillStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum LabOrderStatus {
  PENDING_BILLING
  BILLED
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LabReportStatus {
  PENDING
  COMPLETED
  VERIFIED
}

enum TestAdviceStatus {
  PENDING_BILLING
  CONVERTED
}

enum PharmacySupplierStatus {
  ACTIVE
  INACTIVE
}

enum PharmacyCatalogStatus {
  ACTIVE
  INACTIVE
}

enum PharmacyInventoryBatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
}

enum PharmacyStockTransactionType {
  GRN_IN
  BILLING
  BILL_CANCELLED
  SALE_OUT
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
  CUSTOMER_RETURN
  VENDOR_RETURN
  EXPIRED_RETURN
  DAMAGED_RETURN
  OT_ISSUE
  OT_RETURN
}

enum OtMedicineIssueStatus {
  REQUESTED
  ISSUED
  IN_USE
  RETURN_PENDING
  CLOSED
  CANCELLED
}

enum OtMedicineMovementType {
  REQUEST
  ISSUE
  USE
  RETURN_SUBMITTED
  RETURN_CONFIRMED
  VOID
  ADJUSTMENT
}

enum PharmacyReturnType {
  CUSTOMER_RETURN
  VENDOR_RETURN
  EXPIRED_RETURN
  DAMAGED_RETURN
}

enum PharmacyReturnStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum PharmacyRefundType {
  CASH
  UPI
  STORE_CREDIT
  NO_REFUND
}

enum PharmacyBillingType {
  HOSPITAL_PATIENT
  WALK_IN
}

enum PharmacyBillStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PharmacyPaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  MIXED
}

enum PharmacyDispenseStatus {
  PENDING
  DISPENSED
}

enum PharmacyGrnReceiptStatus {
  Full
  Partial
}

model Hospital {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  address   String
  city      String
  state     String
  pincode   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  abdmFacilityConfig AbdmFacilityConfig?
  abdmAuditLogs      AbdmAuditLog[]
  patients           Patient[]
  users              User[]
  wards              Ward[]
  admissions         Admission[]
  consultations      Consultation[]
  labOrders          LabOrder[]
}

model AbdmFacilityConfig {
  id           String    @id @default(uuid()) @db.Uuid
  hospitalId   String    @unique @db.Uuid
  facilityId   String
  facilityName String
  hipId        String?
  hiuId        String?
  bridgeId     String
  bridgeUrl    String?
  isHipActive  Boolean   @default(false)
  isHiuActive  Boolean   @default(false)
  registeredAt DateTime?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

enum AbdmTokenType {
  GATEWAY
  ABHA_XTOKEN
  LINK_TOKEN
}

model AbdmTokenCache {
  id          String         @id @default(uuid()) @db.Uuid
  tokenType   AbdmTokenType
  key         String
  accessToken String
  expiresAt   DateTime
  meta        Json?
}

enum AbdmAuditDirection {
  OUT
  IN
}

model AbdmAuditLog {
  id           String              @id @default(uuid()) @db.Uuid
  hospitalId   String?             @db.Uuid
  direction    AbdmAuditDirection
  apiName      String
  requestId    String
  statusCode   Int
  requestHash  String
  responseHash String
  error        String?
  createdAt    DateTime            @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([requestId])
  @@index([createdAt])
}

/// Episode-level ABDM care context. Does not replace Patient.careContextId.
model AbdmCareContext {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @db.Uuid
  careContextId String   @unique
  episodeType   String
  sourceType    String
  sourceId      String
  hiType        String
  display       String?
  linkStatus    String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient   Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documents AbdmHealthDocument[]

  @@unique([sourceType, sourceId])
  @@index([patientId])
  @@index([episodeType, sourceId])
}

/// Persisted ABDM clinical document / sync metadata for one source record.
model AbdmHealthDocument {
  id                String    @id @default(uuid()) @db.Uuid
  patientId         String    @db.Uuid
  careContextId     String
  abdmCareContextId String?   @db.Uuid
  sourceType        String
  sourceId          String
  hiType            String
  payload           Json
  syncStatus        String    @default("PENDING")
  requestId         String?
  errorCode         String?
  errorMessage      String?
  lastNotifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  careContext AbdmCareContext? @relation(fields: [abdmCareContextId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([patientId])
  @@index([careContextId])
  @@index([syncStatus])
}

/// HIU consent-request init (M3 on-init): gateway consentRequest.id mapped to local requestId.
model AbdmConsentRequest {
  id               String   @id @default(uuid()) @db.Uuid
  consentRequestId String   @unique
  requestId        String?
  consentId        String?
  artefactId       String?
  abhaAddress      String?
  status           String   @default("PENDING")
  errorCode        String?
  errorMessage     String?
  rawPayload       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([requestId])
  @@index([status])
  @@index([consentId])
}

/// HIU M3 health-information request (sandbox). Private key is never returned by APIs.
model AbdmHiuHiTransaction {
  id                      String    @id @default(uuid()) @db.Uuid
  transactionId           String?   @unique
  consentId               String
  requestId               String?
  dateFrom                String?
  dateTo                  String?
  dataPushUrl             String
  publicKey               String
  privateKey              String
  nonce                   String
  hipId                   String?
  careContextReferences   Json?
  status                  String    @default("PENDING")
  errorCode               String?
  errorMessage            String?
  resultMeta              Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([consentId])
  @@index([requestId])
  @@index([status])
}

/// Decrypted HIU FHIR document from an external HIP data-push (no keys).
model AbdmHiuHealthRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  transactionId         String
  consentId             String
  careContextReference  String
  resourceType          String
  recordType            String
  fhirPayload           Json
  sourceHipId           String?
  receivedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([transactionId, careContextReference])
  @@index([consentId])
  @@index([recordType])
}

/// HIP consent notify mapping: consentId → patient ABHA (and Patient.id when found).
model AbdmHipConsent {
  id                     String   @id @default(uuid()) @db.Uuid
  consentId              String   @unique
  abhaAddress            String
  patientId              String?  @db.Uuid
  status                 String?
  careContextReferences  Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([abhaAddress])
  @@index([patientId])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  password     String
  role         Role
  username     String?
  employeeId   String?   @unique
  phone        String?
  address      String?
  department   String?
  profilePhoto String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?
  hospitalId   String?   @db.Uuid

  hospital                 Hospital?                @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  activityLogs             ActivityLog[]
  doctorProfile            Doctor?
  notifications            Notification[]
  assignedAdmissions       Admission[]              @relation("AssignedNurseAdmissions")
  nursingNotes             NursingNote[]            @relation("UserNursingNotes")
  dailyExpenses            DailyExpense[]           @relation("UserDailyExpenses")
  bedTransfersCreated      BedTransfer[]            @relation("BedTransferCreatedBy")
  labOrdersBilled          LabOrder[]               @relation("LabOrderBilledBy")
  labResultsEntered        LabResult[]              @relation("LabResultEnteredBy")
  pharmacySuppliersCreated PharmacySupplier[]       @relation("PharmacySupplierCreatedBy")
  pharmacyQueuesSent       PharmacyQueue[]          @relation("PharmacyQueueSentBy")
  otRequestsCreated        OtRequest[]              @relation("OtRequestNurse")
  otRequestStatusChanges   OtRequestStatusHistory[]
  otNurseSchedules         SurgerySchedule[]        @relation("OTNurseSchedule")
  createdSurgerySchedules  SurgerySchedule[]        @relation("SurgeryScheduleCreatedBy")
  recoveryAssessments      RecoveryAssessment[]
  recoveryTransfers        RecoveryTransfer[]
  assignedRecoveryRecords  RecoveryRecord[]         @relation("RecoveryAssignedNurse")
  preOpAssessments         PreOperativeAssessment[]
  departmentHead           Department?              @relation("DepartmentHead")

  nurseTasks   NurseTask[]
  doctorOrders DoctorOrder[]

  shiftAssignments         ShiftAssignment[] @relation("ShiftAssignmentEmployee")
  assignedShiftAssignments ShiftAssignment[] @relation("ShiftAssignmentAssigner")
  shiftHistoryActions      ShiftHistory[]    @relation("ShiftHistoryChangedBy")
  nurseTestAdviceRequests  TestAdvice[]      @relation("NurseTestAdviceRequests")

  @@index([role])
  @@index([isActive])
  @@index([hospitalId])
}

model ActivityLog {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  action    ActivityAction
  module    ActivityModule
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([module])
}

model Doctor {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @unique @db.Uuid
  specialization  String
  qualification   String
  experienceYears Int
  phone           String
  gender          Gender

  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability              DoctorAvailability[]
  appointments              Appointment[]
  consultations             Consultation[]
  admissions                Admission[]
  ipdNotes                  IpdNote[]
  treatmentPlanHistory      TreatmentPlanHistory[]
  labOrders                 LabOrder[]
  testAdvices               TestAdvice[]
  pharmacyQueues            PharmacyQueue[]
  otRequests                OtRequest[]
  surgeonSchedules          SurgerySchedule[]    @relation("SurgeonSchedule")
  assistantSurgeonSchedules SurgerySchedule[]    @relation("AssistantSurgeonSchedule")
  anaesthetistSchedules     SurgerySchedule[]    @relation("AnaesthetistSchedule")
  referredConsultations     Consultation[]       @relation("ReferredConsultations")

  @@index([specialization])
  @@index([experienceYears])
}

model DoctorAvailability {
  id          String    @id @default(uuid()) @db.Uuid
  doctorId    String    @db.Uuid
  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  isAvailable Boolean   @default(false)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
  @@index([dayOfWeek])
}

model Patient {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  uhid               String?            @unique
  regSeq             Int                @unique @default(autoincrement())
  registrationNumber String?            @unique
  age                Int?
  gender             Gender?
  mobile             String?
  basicHistory       String?
  dob                DateTime?
  aadhaarId          String?
  abhaNumber         String?
  abhaAddress        String?
  abhaStatus         String?
  phrAddress         Json?
  healthIdNumber     String?
  isAbhaVerified     Boolean            @default(false)
  mobileVerified     Boolean            @default(false)
  aadhaarVerified    Boolean            @default(false)
  abdmVerifiedAt     DateTime?
  hipLinked          Boolean            @default(false)
  careContextId      String?
  careContextStatus  String?
  linkedAt           DateTime?
  syncStatus         String?
  hipLinkRequestId   String?
  hipReferenceNumber String?
  address            String?
  bloodGroup         String?
  allergies          String?
  heightCm           Int?
  weightKg           Int?
  emergencyName      String?
  emergencyPhone     String?
  emergencyRelation  String?
  registrationSource RegistrationSource @default(RECEPTION)
  createdAt          DateTime           @default(now())
  hospitalId         String?            @db.Uuid

  hospital         Hospital?          @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  consultations    Consultation[]
  admissions       Admission[]
  visits           ReceptionVisit[]
  bills            Bill[]
  labOrders        LabOrder[]
  testAdvices      TestAdvice[]
  pharmacyBills    PharmacyBill[]
  pharmacyQueues   PharmacyQueue[]
  pharmacyPayments PharmacyPayment[]
  pharmacyReturns  PharmacyReturn[]
  otRequests           OtRequest[]
  patientAuth          PatientAuth?
  otMedicineIssues     OtMedicineIssue[]
  abdmCareContexts     AbdmCareContext[]
  abdmHealthDocuments  AbdmHealthDocument[]

  @@index([name])
  @@index([createdAt])
  @@index([hospitalId])
}

model PatientAuth {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @unique @db.Uuid
  password    String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model ReceptionVisit {
  id              String               @id @default(uuid()) @db.Uuid
  patientId       String               @db.Uuid
  visitType       VisitType            @default(OPD)
  status          ReceptionVisitStatus @default(WAITING)
  department      String?
  doctorName      String?
  visitDate       DateTime             @default(now())
  token           String?
  queueNumber     Int?
  registrationFee Int?
  paymentMode     String?
  paymentStatus   String?
  referBy         String?
  sponsor         String?
  createdAt       DateTime             @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, visitDate])
  @@index([visitDate])
  @@index([status])
  @@index([visitType])
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  patientId     String            @db.Uuid
  doctorId      String            @db.Uuid
  opdSeq        Int               @unique @default(autoincrement())
  opdNumber     String?           @unique
  date          DateTime
  time          String?
  token         String?
  department    String?
  fee           Int?
  paymentMode   String?
  paymentStatus String?
  status        AppointmentStatus @default(WAITING)
  createdAt     DateTime          @default(now())

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor         Doctor          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  consultations  Consultation[]
  bills          Bill[]
  labOrders      LabOrder[]
  pharmacyQueues PharmacyQueue[]

  @@index([doctorId, date])
  @@index([patientId, date])
  @@index([date])
}

model Consultation {
  id                String                  @id @default(uuid()) @db.Uuid
  patientId         String                  @db.Uuid
  doctorId          String                  @db.Uuid
  appointmentId     String?                 @db.Uuid
  symptoms          String
  diagnosis         String
  prescription      Json
  labTests          Json?
  followUpDate      DateTime?
  disposition       ConsultationDisposition @default(NORMAL)
  suggestedWardType WardType?
  referredDepartment String?
  referredDoctorId  String?                 @db.Uuid
  createdAt         DateTime                @default(now())
  hospitalId        String?                 @db.Uuid

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  referredDoctor Doctor?   @relation("ReferredConsultations", fields: [referredDoctorId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  hospital    Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  labOrders   LabOrder[]
  testAdvice  TestAdvice?

  @@index([doctorId, createdAt])
  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([hospitalId])
}

/// Admin-managed catalog (integer id) for OPD test advice & billing hints.
model LabTest {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  price     Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adviceItems TestAdviceItem[]

  @@index([isActive])
  @@index([category])
}

/// Admin-editable lab test categories (reception billing dropdown).
model LabCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestAdvice {
  id                Int              @id @default(autoincrement())
  patientId         String           @db.Uuid
  doctorId          String           @db.Uuid
  consultationId    String?          @unique @db.Uuid
  status            TestAdviceStatus @default(PENDING_BILLING)
  labOrderId        String?          @unique @db.Uuid
  admissionId       String?          @db.Uuid
  requestedByUserId String?          @db.Uuid
  source            String?
  clinicalNote      String?
  createdAt         DateTime         @default(now())

  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  consultation Consultation?    @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  labOrder     LabOrder?        @relation(fields: [labOrderId], references: [id], onDelete: SetNull)
  admission    Admission?       @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  requestedBy  User?            @relation("NurseTestAdviceRequests", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  items        TestAdviceItem[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@index([status, createdAt])
  @@index([admissionId, createdAt])
  @@index([source, status, createdAt])
}

model TestAdviceItem {
  id       Int @id @default(autoincrement())
  adviceId Int
  testId   Int

  advice TestAdvice @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  test   LabTest    @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@index([adviceId])
  @@index([testId])
}

model LabTestCatalog {
  id         String   @id @default(uuid()) @db.Uuid
  category   String
  name       String
  code       String   @unique
  sampleType String?
  unit       String?
  referenceRange String?
  price      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems LabOrderItem[]

  @@index([category])
  @@index([isActive])
}

model LabOrder {
  id            String        @id @default(uuid()) @db.Uuid
  orderNumber   String        @unique
  patientId     String        @db.Uuid
  doctorId      String        @db.Uuid
  appointmentId String?       @db.Uuid
  consultationId String?      @db.Uuid
  status        LabOrderStatus @default(PENDING_BILLING)
  reportStatus  LabReportStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  billedAt      DateTime?
  billedByUserId String?      @db.Uuid
  billId        String?       @db.Uuid
  hospitalId    String?       @db.Uuid

  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  consultation  Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  billedBy      User?         @relation("LabOrderBilledBy", fields: [billedByUserId], references: [id], onDelete: SetNull)
  bill          Bill?         @relation(fields: [billId], references: [id], onDelete: SetNull)
  hospital      Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  items         LabOrderItem[]
  results       LabResult[]
  testAdviceConversion TestAdvice?

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@index([status, createdAt])
  @@index([billId])
  @@index([hospitalId])
}

model LabOrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  labOrderId  String   @db.Uuid
  testId      String?  @db.Uuid
  testName    String
  category    String?
  unit        String?
  referenceRange String?
  price       Int      @default(0)
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  test     LabTestCatalog? @relation(fields: [testId], references: [id], onDelete: SetNull)
  results  LabResult[] @relation("LabResultOrderItem")

  @@index([labOrderId])
  @@index([testId])
}

model LabResult {
  id          String   @id @default(uuid()) @db.Uuid
  labOrderId  String   @db.Uuid
  orderItemId String?  @db.Uuid
  testName    String
  value       String
  unit        String?
  referenceRange String?
  category    String?
  remarks     String?
  attachmentUrl String?
  createdAt   DateTime @default(now())
  enteredByUserId String? @db.Uuid

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  orderItem LabOrderItem? @relation("LabResultOrderItem", fields: [orderItemId], references: [id], onDelete: SetNull)
  enteredBy User? @relation("LabResultEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)

  @@index([labOrderId, createdAt])
  @@index([orderItemId])
}

model Admission {
  id                   String                   @id @default(uuid()) @db.Uuid
  /**
   * Human-readable IPD id, e.g. IPD-20260421-0001 (separate from internal UUID).
   */
  ipdNumber            String?                  @unique
  patientId            String                   @db.Uuid
  doctorId             String                   @db.Uuid
  nurseId              String?                  @db.Uuid
  // Legacy field (keep for compatibility with old UI)
  bedNumber            String?
  wardId               String?                  @db.Uuid
  bedId                String?                  @db.Uuid
  department           String?
  admissionType        String?
  admissionDate        DateTime                 @default(now())
  status               AdmissionStatus          @default(ADMITTED)
  clinicalCondition    PatientClinicalCondition @default(STABLE)
  dischargeDate        DateTime?
  /**
   * Set when nurse requests discharge (status DISCHARGE_REQUESTED)
   */
  dischargeRequestedAt DateTime?
  notesText            String?
  /**
   * Receptionist editable discharge summary (saved on final discharge).
   */
  dischargeSummaryData Json?
  /**
   * Nurse assessment, tasks, ICU monitoring JSON (saved via PUT /api/nurse/clinical-data)
   */
  nurseCareData        Json?
  createdAt            DateTime                 @default(now()) // legacy timestamp (keep)
  hospitalId           String?                  @db.Uuid

  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  nurse         User?             @relation("AssignedNurseAdmissions", fields: [nurseId], references: [id], onDelete: SetNull)
  ward          Ward?             @relation(fields: [wardId], references: [id], onDelete: SetNull)
  bed           Bed?              @relation(fields: [bedId], references: [id], onDelete: SetNull)
  hospital      Hospital?         @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  notes         IpdNote[]
  nursingNotes  NursingNote[]
  vitalsRecords Vitals[]
  treatmentPlan TreatmentPlan?
  treatmentPlanHistory TreatmentPlanHistory[]
  transfers     BedTransfer[]
  billing       AdmissionBilling?
  bills         Bill[]
  otRequests         OtRequest[]
  testAdviceRequests TestAdvice[]
  pharmacyQueues     PharmacyQueue[]
  pharmacyBills      PharmacyBill[]
  dailyExpenses      DailyExpense[]

  @@index([doctorId, status])
  @@index([nurseId, status])
  @@index([patientId, status])
  @@index([createdAt])
  @@index([wardId])
  @@index([bedId])
  @@index([hospitalId])
}

