PORT=5000
FRONTEND_URL=http://localhost:5173

# Prisma / Postgres (Render: add connect_timeout if idle drops)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ht_hospital?schema=public&connect_timeout=15"

# Auth
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m

# Seed (first SUPER_ADMIN — created/updated on server start)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@ht-hospital.local
# Must match what you set here after first deploy (default used by seed on server start)
SUPER_ADMIN_PASSWORD=admin123

# Demo staff accounts (doctor, nurse, receptionist, lab, HR) — created by npm run seed
DEMO_STAFF_PASSWORD=ChangeMeNow123!

# Limits
# Max staff users allowed (excluding SUPER_ADMIN). Set to 0 or leave empty for unlimited.
MAX_STAFF_USERS=50

ABDM_ENV=sandbox
ABDM_CM_ID=sbx
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BRIDGE_ID=
# Optional until hospital HRP registration returns/sets hipId on AbdmFacilityConfig
ABDM_HIP_ID=
ABDM_GATEWAY_BASE=https://dev.abdm.gov.in/api/hiecm
ABDM_ABHA_BASE=https://abhasbx.abdm.gov.in
ABDM_HSP_BASE=https://apihspsbx.abdm.gov.in
# Must be public HTTPS URL where ABDM can call your callbacks
ABDM_BRIDGE_CALLBACK_URL=
ABDM_DEFAULT_HOSPITAL_CODE=main
ABDM_ENABLED=true
