PORT=5000
FRONTEND_URL=http://localhost:5173

# Prisma / Postgres
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ht_hospital?schema=public"

# Auth
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m

# Seed (first SUPER_ADMIN)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@ht-hospital.local
SUPER_ADMIN_PASSWORD=ChangeMeNow123!

# Limits
# Max staff users allowed (excluding SUPER_ADMIN). Set to 0 or leave empty for unlimited.
MAX_STAFF_USERS=50
